rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    // ============ USERS ============
    match /users/{uid} {
      allow read: if isSignedIn();
      allow create, update: if isOwner(uid);
      allow delete: if false;
    }

    // ============ REQUESTS ============
    match /requests/{requestId} {
      allow read: if isSignedIn();

      // Hanya user terautentikasi yang bisa membuat request, dan ia harus
      // menjadi requester dari request tersebut.
      allow create: if isSignedIn()
        && request.resource.data.requesterId == request.auth.uid
        && request.resource.data.status == 'OPEN';

      // Update boleh oleh requester atau traveler yang sudah terlibat.
      allow update: if isSignedIn() && (
        resource.data.requesterId == request.auth.uid ||
        resource.data.travelerId == request.auth.uid ||
        // Traveler baru yang mengambil request OPEN
        (resource.data.status == 'OPEN'
          && request.resource.data.travelerId == request.auth.uid)
      );

      // Delete hanya oleh requester saat status masih OPEN.
      allow delete: if isSignedIn()
        && resource.data.requesterId == request.auth.uid
        && resource.data.status == 'OPEN';

      // Sub-collection chat: hanya pihak yang terlibat.
      match /messages/{messageId} {
        allow read, create: if isSignedIn() && (
          get(/databases/$(database)/documents/requests/$(requestId)).data.requesterId == request.auth.uid ||
          get(/databases/$(database)/documents/requests/$(requestId)).data.travelerId == request.auth.uid
        );
        allow update, delete: if false;
      }
    }
  }
}
